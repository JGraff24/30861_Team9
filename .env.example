# Local system inputs. No token is enabled by default.
APP_ENV=development
API_ROOT_PATH=
RULESET_VERSION=1.0.0
DEPLOYMENT_SHA=unknown
METADATA_DB_PATH=state/system.sqlite3
BLOB_BACKEND=filesystem
BLOB_ROOT=state/sources
# Set both when choosing s3; use your private bucket and actual region.
# S3_BUCKET=YOUR_PRIVATE_BUCKET
S3_PREFIX=sources/
# AWS_REGION=YOUR_AWS_REGION
SYSTEM_TOKEN_HASHES_JSON={}
REVIEWER_GRANTS_JSON={}
# Set real module:factory paths only after Dylan/Ryan implementations are present.
# ENGINE_FACTORY=app.workbooks.engine:create_engine
# RUNNER_FACTORY=app.measurement.runner:create_runner
# SESSION_SERVICE_FACTORY=app.test_interface.sessions:create_session_service
# TEST_ROUTER_FACTORY=app.test_interface.routes:create_router
# UI_ROUTER_FACTORY=app.ui.routes:create_router
# These commented paths are integration examples, not existing implementations.
ENGINE_MEMORY_LIMIT_MIB=512
ENABLE_TEST_INTERFACE=false
TEST_SESSION_USERS_JSON={}
ENABLE_CODE_MEASUREMENT=false
VALIDATION_TIMEOUT_SECONDS=30
AUDIT_TIMEOUT_SECONDS=60
QUEUE_TIMEOUT_SECONDS=15
TESTER_ROOT_PATH=
TESTER_DB_PATH=state/tester.sqlite3
TESTER_OPERATOR_TOKEN_HASHES_JSON={}
ALLOWED_TARGET_URLS=[]
TARGET_AUTH_MAP_JSON={}
FIXTURE_MANIFEST_PATH=tests/fixtures/manifest.json
TESTER_SETUP_TIMEOUT_SECONDS=45
TESTER_RUN_TIMEOUT_SECONDS=600
