# Local system inputs. No token is enabled by default.
APP_ENV=development
API_ROOT_PATH=
RULESET_VERSION=2.0.0
DEPLOYMENT_SHA=unknown
METADATA_DB_PATH=state/system.sqlite3
BLOB_BACKEND=filesystem
BLOB_ROOT=state/sources
# Set both when choosing s3; use your private bucket and actual region.
# S3_BUCKET=YOUR_PRIVATE_BUCKET
S3_PREFIX=sources/
# AWS_REGION=YOUR_AWS_REGION
SYSTEM_TOKEN_HASHES_JSON={}
REVIEWER_GRANTS_JSON={}
# Concrete defaults are assembled automatically; override only with trusted server factories.
# ENGINE_FACTORY=app.audit.engine:OoxmlWorkbookEngine
# RUNNER_FACTORY=app.measurement.runner:MeasuredEngineRunner
# SESSION_SERVICE_FACTORY=app.test_interface.service:PersistentSessionService
# TEST_ROUTER_FACTORY=app.test_interface.routes:create_router
# UI_ROUTER_FACTORY=app.ui.routes:create_router
ENGINE_MEMORY_LIMIT_MIB=512
ENABLE_TEST_INTERFACE=false
# Enable only on the designated isolated Phase 4 test deployment.
ENABLE_TEST_AUDIT_FAULTS=false
TEST_SESSION_USERS_JSON={}
ENABLE_CODE_MEASUREMENT=false
VALIDATION_TIMEOUT_SECONDS=30
AUDIT_TIMEOUT_SECONDS=60
REMEDIATION_TIMEOUT_SECONDS=180
QUEUE_TIMEOUT_SECONDS=15
TESTER_ROOT_PATH=
TESTER_DB_PATH=state/tester.sqlite3
TESTER_OPERATOR_TOKEN_HASHES_JSON={}
ALLOWED_TARGET_URLS=[]
# Per approved base URL: {"userA","userB","reviewer","test-admin"} tokens; "reviewer" must hold a
# read grant from userA only. Optional "test-adminB" (a second test-admin) enables the Phase 5
# foreign-admin clock cases; without it they are skips.
TARGET_AUTH_MAP_JSON={}
# Phase 5 report profile (trusted operator configuration only, never a grader field): this
# tester's team ID and the exact approved base URL -> team ID map. An own-team target requires
# TESTER_DESIGN_MAP_PATH (defaults to the packaged docs/design/team9-design-map.json).
TESTER_TEAM_ID=team9
TARGET_TEAM_MAP_JSON={}
# TESTER_DESIGN_MAP_PATH=/absolute/path/team9-design-map.json
# Omit to use repository fixtures or bundled wheel assets. Override for reviewed shared fixtures.
# FIXTURE_MANIFEST_PATH=/absolute/private/fixtures/manifest.json
TESTER_SETUP_TIMEOUT_SECONDS=45
TESTER_RUN_TIMEOUT_SECONDS=1800
# Failed namespaces are always queued for compensation through the next setup.
# Also clean namespaces of successfully retrieved reports when explicitly enabled.
TESTER_CLEANUP_PRIOR_SESSIONS=false
