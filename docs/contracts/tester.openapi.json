{
  "openapi": "3.1.1",
  "info": {
    "title": "Team 9 tester foundation",
    "description": "Bootstrap only. Setup, run and report endpoints pending.",
    "version": "0.1.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "CoverageMeasure": {
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "covered": {
                "type": "null"
              },
              "total": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "covered": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          }
        ],
        "properties": {
          "covered": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Covered"
          },
          "total": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total"
          },
          "basis": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Basis",
            "type": "string"
          }
        },
        "required": [
          "covered",
          "total",
          "basis"
        ],
        "title": "CoverageMeasure",
        "type": "object"
      },
      "ErrorSource": {
        "enum": [
          "tester",
          "system",
          "communication",
          "unknown"
        ],
        "title": "ErrorSource",
        "type": "string"
      },
      "Outcome": {
        "enum": [
          "pass",
          "fail",
          "error",
          "skip"
        ],
        "title": "Outcome",
        "type": "string"
      },
      "RunRequest": {
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "SetupResponse": {
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "SetupResponse",
        "type": "object"
      },
      "SuiteCoverage": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/CoverageMeasure"
          },
          "component": {
            "$ref": "#/components/schemas/CoverageMeasure"
          },
          "system": {
            "$ref": "#/components/schemas/CoverageMeasure"
          }
        },
        "required": [
          "code",
          "component",
          "system"
        ],
        "title": "SuiteCoverage",
        "type": "object"
      },
      "SuiteReport": {
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Session Id",
            "type": "string"
          },
          "target_url": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Target Url",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/TestResult"
            },
            "title": "Results",
            "type": "array"
          },
          "coverage": {
            "$ref": "#/components/schemas/SuiteCoverage"
          }
        },
        "required": [
          "session_id",
          "target_url",
          "results",
          "coverage"
        ],
        "title": "SuiteReport",
        "type": "object"
      },
      "TestEndpointError": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Message",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/ErrorSource"
          }
        },
        "required": [
          "message",
          "source"
        ],
        "title": "TestEndpointError",
        "type": "object"
      },
      "TestResult": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "not": {
                "required": [
                  "source"
                ]
              }
            },
            "if": {
              "properties": {
                "outcome": {
                  "const": "error"
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ]
            }
          }
        ],
        "properties": {
          "test_id": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Test Id",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "message": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Message",
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorSource"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "test_id",
          "outcome",
          "message"
        ],
        "title": "TestResult",
        "type": "object"
      },
      "TesterSetupRequest": {
        "additionalProperties": false,
        "properties": {
          "target_url": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Target Url",
            "type": "string"
          }
        },
        "required": [
          "target_url"
        ],
        "title": "TesterSetupRequest",
        "type": "object"
      }
    }
  },
  "x-foundation-status": "DTO catalog only; all feature endpoints pending",
  "x-team9-contract-profile": "1.0.0",
  "x-instructor-interface-version": "0.4.2"
}
