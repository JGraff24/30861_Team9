{
  "openapi": "3.1.1",
  "info": {
    "title": "Team 9 tester",
    "description": "Instructor cross-team tester: setup, single-use run and stored report.",
    "version": "0.2.0"
  },
  "paths": {
    "/test/setup": {
      "post": {
        "summary": "Setup",
        "operationId": "setup_test_setup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TesterSetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/test/run": {
      "post": {
        "summary": "Run",
        "operationId": "run_test_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stored suite report (byte-identical on retrieval)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuiteReport"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/test/report": {
      "get": {
        "summary": "Report",
        "operationId": "report_test_report_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored suite report (byte-identical on retrieval)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuiteReport"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            },
            "description": "Conflict"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEndpointError"
                }
              }
            },
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CoverageMeasure": {
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "covered": {
                "type": "null"
              },
              "total": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "covered": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          }
        ],
        "properties": {
          "covered": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Covered"
          },
          "total": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total"
          },
          "basis": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Basis",
            "type": "string"
          }
        },
        "required": [
          "covered",
          "total",
          "basis"
        ],
        "title": "CoverageMeasure",
        "type": "object"
      },
      "ErrorSource": {
        "enum": [
          "tester",
          "system",
          "communication",
          "unknown"
        ],
        "title": "ErrorSource",
        "type": "string"
      },
      "Outcome": {
        "enum": [
          "pass",
          "fail",
          "error",
          "skip"
        ],
        "title": "Outcome",
        "type": "string"
      },
      "RunRequest": {
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "SetupResponse": {
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "SetupResponse",
        "type": "object"
      },
      "SuiteCoverage": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/CoverageMeasure"
          },
          "component": {
            "$ref": "#/components/schemas/CoverageMeasure"
          },
          "system": {
            "$ref": "#/components/schemas/CoverageMeasure"
          }
        },
        "required": [
          "code",
          "component",
          "system"
        ],
        "title": "SuiteCoverage",
        "type": "object"
      },
      "SuiteReport": {
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Session Id",
            "type": "string"
          },
          "target_url": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Target Url",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/TestResult"
            },
            "title": "Results",
            "type": "array"
          },
          "coverage": {
            "$ref": "#/components/schemas/SuiteCoverage"
          }
        },
        "required": [
          "session_id",
          "target_url",
          "results",
          "coverage"
        ],
        "title": "SuiteReport",
        "type": "object"
      },
      "TestEndpointError": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Message",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/ErrorSource"
          }
        },
        "required": [
          "message",
          "source"
        ],
        "title": "TestEndpointError",
        "type": "object"
      },
      "TestResult": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "not": {
                "required": [
                  "source"
                ]
              }
            },
            "if": {
              "properties": {
                "outcome": {
                  "const": "error"
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ]
            }
          }
        ],
        "properties": {
          "test_id": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Test Id",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "message": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Message",
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorSource"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "test_id",
          "outcome",
          "message"
        ],
        "title": "TestResult",
        "type": "object"
      },
      "TesterSetupRequest": {
        "additionalProperties": false,
        "properties": {
          "target_url": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Target Url",
            "type": "string"
          }
        },
        "required": [
          "target_url"
        ],
        "title": "TesterSetupRequest",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Grader/operator bearer token",
        "scheme": "bearer"
      }
    }
  },
  "x-foundation-status": "Instructor tester endpoints implemented: /test/setup, /test/run, /test/report",
  "x-team9-contract-profile": "1.0.0",
  "x-instructor-interface-version": "0.4.2"
}
