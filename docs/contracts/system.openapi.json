  "components": {
    "schemas": {
      "AuditResponse": {
        "additionalProperties": false,
        "properties": {
          "auditId": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Auditid",
            "type": "string"
          },
          "workbookId": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Workbookid",
            "type": "string"
          },
          "versionId": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Versionid",
            "type": "string"
          },
          "rulesetVersion": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
            "title": "Rulesetversion",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AuditStatus"
          },
          "startedAt": {
            "format": "date-time",
            "title": "Startedat",
            "type": "string"
          },
          "completedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completedat"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Findings",
            "type": "array"
          },
          "limitations": {
            "items": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProjectError"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "auditId",
          "workbookId",
          "versionId",
          "rulesetVersion",
          "status",
          "startedAt",
          "completedAt",
          "findings",
          "limitations",
          "error"
        ],
        "title": "AuditResponse",
        "type": "object"
      },
      "AuditStatus": {
        "enum": [
          "PROCESSING",
          "AUDIT_COMPLETE",
          "REVIEW_REQUIRED",
          "REMEDIATION_AVAILABLE",
          "PROCESSING_FAILED"
        ],
        "title": "AuditStatus",
        "type": "string"
      },
      "CoverageMeasure": {
        "additionalProperties": false,
        "oneOf": [
          {
            "properties": {
              "covered": {
                "type": "null"
              },
              "total": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "covered": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          }
        ],
        "properties": {
          "covered": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Covered"
          },
          "total": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total"
          },
          "basis": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Basis",
            "type": "string"
          }
        },
        "required": [
          "covered",
          "total",
          "basis"
        ],
        "title": "CoverageMeasure",
        "type": "object"
      },
      "ErrorSource": {
        "enum": [
          "tester",
          "system",
          "communication",
          "unknown"
        ],
        "title": "ErrorSource",
        "type": "string"
      },
      "Finding": {
        "additionalProperties": false,
        "properties": {
          "findingId": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "title": "Findingid",
            "type": "string"
          },
          "ruleId": {
            "minLength": 1,
            "pattern": "\\S",
            "title": "Ruleid",
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/FindingCategory"
          },
          "worksheet": {
            "title": "Worksheet",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          },
          "classification": {
            "$ref": "#/components/schemas/FindingClassification"
          },
          "message": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Message",
            "type": "string"
          },
          "recommendation": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Recommendation",
            "type": "string"
          }
        },
        "required": [
          "findingId",
          "ruleId",
          "category",
          "worksheet",
          "target",
          "classification",
          "message",
          "recommendation"
        ],
        "title": "Finding",
        "type": "object"
      },
      "FindingCategory": {
        "enum": [
          "NON_TEXT_CONTENT",
          "TABLE_STRUCTURE",
          "MERGED_CELLS",
          "WORKSHEET_NAME",
          "LINK_TEXT",
          "COLOR_OR_CONTRAST"
        ],
        "title": "FindingCategory",
        "type": "string"
      },
      "FindingClassification": {
        "enum": [
          "AUTOMATICALLY_REMEDIABLE",
          "REQUIRES_USER_INPUT",
          "MANUAL_REVIEW"
        ],
        "title": "FindingClassification",
        "type": "string"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "AVAILABLE",
            "title": "Status",
            "type": "string"
          },
          "apiVersion": {
            "const": "1.0",
            "title": "Apiversion",
            "type": "string"
          },
          "rulesetVersion": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
            "title": "Rulesetversion",
            "type": "string"
          }
        },
        "required": [
          "status",
          "apiVersion",
          "rulesetVersion"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JsonValue": {},
      "ProjectError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "minLength": 1,
