    "AuditReport": {
      "type": "object",
      "properties": {
        "reportVersion": {
          "const": "2.0.0"
        },
        "specificationVersion": {
          "const": "2.1.0"
        },
        "workbookId": {
          "$ref": "#/$defs/Identifier"
        },
        "versionId": {
          "$ref": "#/$defs/Identifier"
        },
        "auditId": {
          "$ref": "#/$defs/Identifier"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
