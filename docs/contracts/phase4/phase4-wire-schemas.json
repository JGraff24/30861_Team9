        "sha256": {
          "$ref": "#/$defs/SHA256"
        },
        "sourceVersionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "auditDate": {
          "$ref": "#/$defs/Timestamp"
        },
        "rulesetVersion": {
          "$ref": "#/$defs/SemVer"
        },
        "status": {
          "type": "string",
          "enum": [
            "AUDIT_COMPLETE",
            "REVIEW_REQUIRED",
            "REMEDIATION_AVAILABLE",
            "PROCESSING_FAILED"
          ]
        },
        "checksPerformed": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ALT_TEXT",
              "WORKSHEET_NAME",
              "TABLE_HEADER",
              "MERGED_CELLS",
              "LINK_TEXT",
              "COLOR_CONTRAST"
            ]
          },
          "uniqueItems": true
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportDecision"
          }
        },
        "approvedChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApprovedChange"
          }
        },
        "unresolvedFindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "manualReviewItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "remediationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputVersionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "reportVersion",
        "specificationVersion",
        "workbookId",
        "versionId",
        "auditId",
        "fileName",
        "sha256",
        "sourceVersionId",
        "auditDate",
        "rulesetVersion",
        "status",
        "checksPerformed",
        "findings",
        "decisions",
        "approvedChanges",
        "unresolvedFindings",
        "manualReviewItems",
        "limitations",
        "remediationId",
        "outputVersionId",
        "outputId",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PROCESSING_FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/ProjectError"
              },
              "findings": {
                "maxItems": 0
              },
              "unresolvedFindings": {
                "maxItems": 0
              },
              "manualReviewItems": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              },
              "checksPerformed": {
                "const": [
                  "ALT_TEXT",
                  "WORKSHEET_NAME",
                  "TABLE_HEADER",
                  "MERGED_CELLS",
                  "LINK_TEXT",
                  "COLOR_CONTRAST"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "AUDIT_COMPLETE"
              }
            }
          },
          "then": {
            "properties": {
              "findings": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "REVIEW_REQUIRED",
                  "REMEDIATION_AVAILABLE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "findings": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
