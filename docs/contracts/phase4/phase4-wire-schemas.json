{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:excel-accessibility-hub:phase4:wire:2.1.0",
  "title": "Phase 4 shared wire definitions",
  "description": "Select the named definition for each endpoint. Cross-resource ownership, rule/value matching, date ordering, coverage inequalities, sorting, ID uniqueness, and semantic checks are normative in the specification and require application validation. These definitions specify the shared interface; they are not evidence that a deployment implements it.",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "SHA256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "ProjectError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "requestId": {
          "$ref": "#/$defs/Identifier"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "requestId",
        "details"
      ],
      "additionalProperties": false
    },
    "TestEndpointError": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "enum": [
            "tester",
            "system",
            "communication",
            "unknown"
          ]
        }
      },
      "required": [
        "message",
        "source"
      ],
      "additionalProperties": false
    },
    "HealthResponse": {
      "type": "object",
      "properties": {
        "status": {
          "const": "AVAILABLE"
        },
        "apiVersion": {
          "const": "1.0"
        },
        "rulesetVersion": {
          "$ref": "#/$defs/SemVer"
        }
      },
      "required": [
        "status",
        "apiVersion",
        "rulesetVersion"
      ],
      "additionalProperties": false
    },
    "UploadResponse": {
      "type": "object",
      "properties": {
        "workbookId": {
          "$ref": "#/$defs/Identifier"
        },
        "versionId": {
          "$ref": "#/$defs/Identifier"
        },
        "auditId": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "const": "PROCESSING"
        }
      },
      "required": [
        "workbookId",
        "versionId",
        "auditId",
        "status"
      ],
      "additionalProperties": false
    },
    "VersionStatus": {
      "type": "string",
      "enum": [
        "PROCESSING",
        "AUDIT_COMPLETE",
        "REVIEW_REQUIRED",
        "REMEDIATION_AVAILABLE",
        "REMEDIATING",
        "REMEDIATED",
        "PROCESSING_FAILED"
      ]
    },
    "AuditStatus": {
      "type": "string",
      "enum": [
        "PROCESSING",
        "AUDIT_COMPLETE",
        "REVIEW_REQUIRED",
        "REMEDIATION_AVAILABLE",
        "PROCESSING_FAILED"
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "findingId": {
          "$ref": "#/$defs/SHA256"
        },
        "ruleId": {
          "type": "string",
          "enum": [
            "ALT_TEXT",
            "WORKSHEET_NAME",
            "TABLE_HEADER",
            "MERGED_CELLS",
            "LINK_TEXT",
            "COLOR_CONTRAST"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "NON_TEXT_CONTENT",
            "WORKSHEET_NAME",
            "TABLE_STRUCTURE",
            "MERGED_CELLS",
            "LINK_TEXT",
            "COLOR_OR_CONTRAST"
          ]
        },
        "worksheet": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "classification": {
          "type": "string",
          "enum": [
            "AUTOMATICALLY_REMEDIABLE",
            "REQUIRES_USER_INPUT",
            "MANUAL_REVIEW"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "required": [
        "findingId",
        "ruleId",
        "category",
        "worksheet",
        "target",
        "classification",
        "message",
        "recommendation"
      ],
      "additionalProperties": false
    },
    "VersionResponse": {
      "type": "object",
      "properties": {
        "workbookId": {
          "$ref": "#/$defs/Identifier"
        },
        "versionId": {
          "$ref": "#/$defs/Identifier"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "sha256": {
          "$ref": "#/$defs/SHA256"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "status": {
          "$ref": "#/$defs/VersionStatus"
        },
        "latestAuditId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceVersionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "workbookId",
        "versionId",
        "fileName",
        "sha256",
        "createdAt",
        "status",
        "latestAuditId",
        "sourceVersionId"
      ],
      "additionalProperties": false
    },
    "AuditResponse": {
      "type": "object",
      "properties": {
        "auditId": {
          "$ref": "#/$defs/Identifier"
        },
        "workbookId": {
          "$ref": "#/$defs/Identifier"
        },
        "versionId": {
          "$ref": "#/$defs/Identifier"
        },
        "rulesetVersion": {
          "$ref": "#/$defs/SemVer"
        },
        "status": {
          "$ref": "#/$defs/AuditStatus"
        },
        "startedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "completedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "auditId",
        "workbookId",
        "versionId",
        "rulesetVersion",
        "status",
        "startedAt",
        "completedAt",
        "findings",
        "limitations",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PROCESSING"
              }
            }
          },
          "then": {
            "properties": {
              "completedAt": {
                "type": "null"
              },
              "error": {
                "type": "null"
              },
              "findings": {
                "maxItems": 0
              },
              "limitations": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PROCESSING_FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "completedAt": {
                "$ref": "#/$defs/Timestamp"
              },
              "error": {
                "$ref": "#/$defs/ProjectError"
              },
              "findings": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "AUDIT_COMPLETE",
                  "REVIEW_REQUIRED",
                  "REMEDIATION_AVAILABLE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "completedAt": {
                "$ref": "#/$defs/Timestamp"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "AUDIT_COMPLETE"
              }
            }
          },
          "then": {
            "properties": {
              "findings": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "REVIEW_REQUIRED",
                  "REMEDIATION_AVAILABLE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "findings": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "REVIEW_REQUIRED"
              },
              "rulesetVersion": {
                "const": "2.0.0"
              }
            }
          },
          "then": {
            "properties": {
              "findings": {
                "items": {
                  "properties": {
                    "classification": {
                      "const": "MANUAL_REVIEW"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "REMEDIATION_AVAILABLE"
              },
              "rulesetVersion": {
                "const": "2.0.0"
              }
            }
          },
          "then": {
            "properties": {
              "findings": {
                "contains": {
                  "properties": {
                    "classification": {
                      "const": "REQUIRES_USER_INPUT"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ReauditRequest": {
      "type": "object",
      "properties": {
        "reason": {
          "const": "MANUAL_REAUDIT"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ReauditResponse": {
      "type": "object",
      "properties": {
        "auditId": {
          "$ref": "#/$defs/Identifier"
        },
        "versionId": {
          "$ref": "#/$defs/Identifier"
        },
        "rulesetVersion": {
          "$ref": "#/$defs/SemVer"
        },
        "status": {
          "const": "PROCESSING"
        }
      },
      "required": [
        "auditId",
        "versionId",
        "rulesetVersion",
        "status"
      ],
      "additionalProperties": false
    },
    "AltTextValue": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800,
          "pattern": "\\S"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false
    },
    "WorksheetNameValue": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31,
          "pattern": "\\S"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "LinkTextValue": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "HeaderRowValue": {
      "type": "object",
      "properties": {
        "headerRow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "headerRow"
      ],
      "additionalProperties": false
    },
    "CorrectionValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/AltTextValue"
        },
        {
          "$ref": "#/$defs/WorksheetNameValue"
        },
        {
          "$ref": "#/$defs/LinkTextValue"
        },
        {
          "$ref": "#/$defs/HeaderRowValue"
        }
      ]
    },
    "Decision": {
      "type": "object",
      "properties": {
        "findingId": {
          "$ref": "#/$defs/SHA256"
        },
        "action": {
          "type": "string",
          "enum": [
            "APPLY",
            "DECLINE",
            "MANUAL_REVIEW"
          ]
        },
        "value": {
          "$ref": "#/$defs/CorrectionValue"
        }
      },
      "required": [
        "findingId",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "APPLY"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          },
          "else": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    },
    "RemediationRequest": {
      "type": "object",
      "properties": {
        "auditId": {
          "$ref": "#/$defs/Identifier"
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "auditId",
        "decisions"
      ],
      "additionalProperties": false
    },
    "RemediationAccepted": {
      "type": "object",
      "properties": {
        "remediationId": {
          "$ref": "#/$defs/Identifier"
        },
        "sourceVersionId": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "const": "REMEDIATING"
        }
      },
      "required": [
        "remediationId",
        "sourceVersionId",
        "status"
      ],
      "additionalProperties": false
    },
    "RemediationResponse": {
      "type": "object",
      "properties": {
        "remediationId": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "type": "string",
          "enum": [
            "REMEDIATING",
            "REMEDIATED",
            "PROCESSING_FAILED"
          ]
        },
        "sourceVersionId": {
          "$ref": "#/$defs/Identifier"
        },
        "outputVersionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "auditId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "remediationId",
        "status",
        "sourceVersionId",
        "outputVersionId",
        "outputId",
        "auditId",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "REMEDIATING"
              }
            }
          },
          "then": {
            "properties": {
              "outputVersionId": {
                "type": "null"
              },
              "outputId": {
                "type": "null"
              },
              "auditId": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "REMEDIATED"
              }
            }
          },
          "then": {
            "properties": {
              "outputVersionId": {
                "$ref": "#/$defs/Identifier"
              },
              "outputId": {
                "$ref": "#/$defs/Identifier"
              },
              "auditId": {
                "$ref": "#/$defs/Identifier"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PROCESSING_FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "outputVersionId": {
                "type": "null"
              },
              "outputId": {
                "type": "null"
              },
              "auditId": {
                "type": "null"
              },
              "error": {
                "$ref": "#/$defs/ProjectError"
              }
            }
          }
        }
      ]
    },
    "CurrentAltText": {
      "type": "object",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false
    },
    "CurrentName": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "CurrentLinkText": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "ReviewItem": {
      "type": "object",
      "properties": {
        "findingId": {
          "$ref": "#/$defs/SHA256"
        },
        "allowedActions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "APPLY",
              "DECLINE",
              "MANUAL_REVIEW"
            ]
          },
          "uniqueItems": true,
          "maxItems": 3
        },
        "currentValue": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/CurrentAltText"
                },
                {
                  "$ref": "#/$defs/CurrentName"
                },
                {
                  "$ref": "#/$defs/CurrentLinkText"
                },
                {
                  "$ref": "#/$defs/HeaderRowValue"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "required": [
        "findingId",
        "allowedActions",
        "currentValue",
        "reason"
      ],
      "additionalProperties": false
    },
    "ReviewResponse": {
      "type": "object",
      "properties": {
        "workbookId": {
          "$ref": "#/$defs/Identifier"
        },
        "versionId": {
          "$ref": "#/$defs/Identifier"
        },
        "auditId": {
          "$ref": "#/$defs/Identifier"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReviewItem"
          }
        }
      },
      "required": [
        "workbookId",
        "versionId",
        "auditId",
        "items"
      ],
      "additionalProperties": false
    },
    "HistoryVersion": {
      "type": "object",
      "properties": {
        "versionId": {
          "$ref": "#/$defs/Identifier"
        },
        "sourceVersionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/VersionStatus"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "versionId",
        "sourceVersionId",
        "status",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "HistoryAudit": {
      "type": "object",
      "properties": {
        "auditId": {
          "$ref": "#/$defs/Identifier"
        },
        "versionId": {
          "$ref": "#/$defs/Identifier"
        },
        "rulesetVersion": {
          "$ref": "#/$defs/SemVer"
        },
        "status": {
          "$ref": "#/$defs/AuditStatus"
        }
      },
      "required": [
        "auditId",
        "versionId",
        "rulesetVersion",
        "status"
      ],
      "additionalProperties": false
    },
    "HistoryResponse": {
      "type": "object",
      "properties": {
        "workbookId": {
          "$ref": "#/$defs/Identifier"
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HistoryVersion"
          }
        },
        "audits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HistoryAudit"
          }
        }
      },
      "required": [
        "workbookId",
        "versions",
        "audits"
      ],
      "additionalProperties": false
    },
    "ReportDecision": {
      "type": "object",
      "properties": {
        "sourceAuditId": {
          "$ref": "#/$defs/Identifier"
        },
        "findingId": {
          "$ref": "#/$defs/SHA256"
        },
        "ruleId": {
          "type": "string",
          "enum": [
            "ALT_TEXT",
            "WORKSHEET_NAME",
            "TABLE_HEADER",
            "MERGED_CELLS",
            "LINK_TEXT",
            "COLOR_CONTRAST"
          ]
        },
        "worksheet": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "action": {
          "type": "string",
          "enum": [
            "APPLY",
            "DECLINE",
            "MANUAL_REVIEW"
          ]
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/CorrectionValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sourceAuditId",
        "findingId",
        "ruleId",
        "worksheet",
        "target",
        "action",
        "value"
