{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "BucketHealth", "Effect": "Allow", "Action": ["s3:ListBucket"],
     "Resource": "arn:aws:s3:::${S3_BUCKET}"},
    {"Sid": "ImmutableSourceIO", "Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject"],
     "Resource": "arn:aws:s3:::${S3_BUCKET}/sources/*"},
    {"Sid": "NamespaceCleanupAndUploadCompensation", "Effect": "Allow", "Action": ["s3:DeleteObject"],
     "Resource": "arn:aws:s3:::${S3_BUCKET}/sources/*"}
  ]
}
